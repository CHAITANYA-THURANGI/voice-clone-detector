# ==============================================================================
# VOICESHIELD AI - REAL-WORLD PRODUCTION GATEWAY CONFIGURATION
# ==============================================================================
# Rename or copy this file to .env and configure your real credentials.

# ------------------------------------------------------------------------------
# 1. REAL-WORLD EMAIL SETTINGS (SMTP / GMAIL / OUTLOOK)
# ------------------------------------------------------------------------------
# To send real emails from your Gmail account:
# 1. Go to Google Account (myaccount.google.com) > Security
# 2. Enable "2-Step Verification" if not already enabled.
# 3. Under "2-Step Verification", scroll to "App passwords".
# 4. Create an App Password with name "VoiceShield AI" (generates a 16-character code).
# 5. Paste the 16-character code below in SMTP_PASSWORD (without spaces).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=VoiceShield AI Cyber Defense
ALERT_RECIPIENT_EMAIL=

# ------------------------------------------------------------------------------
# 2. REAL-WORLD SMS SETTINGS
# ------------------------------------------------------------------------------
# Option A: ANDROID_SIM (Default for mobile app)
# Uses your Android device's native carrier SIM card SMS plan via Android SmsManager.
# No external SMS API key or charges required!
#
# Option B: TWILIO (Cloud SMS Gateway)
# Sign up at twilio.com to get SID, Auth Token, and Twilio phone number.
#
# Option C: FAST2SMS (India Quick SMS Gateway)
# Sign up at fast2sms.com for instant transactional SMS in India.
SMS_GATEWAY=android_sim
ALERT_RECIPIENT_PHONE=

# Twilio Credentials (Only needed if SMS_GATEWAY=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Fast2SMS Credentials (Only needed if SMS_GATEWAY=fast2sms)
FAST2SMS_API_KEY=

# ------------------------------------------------------------------------------
# 3. CALL DEFENSE THRESHOLDS
# ------------------------------------------------------------------------------
AUTO_DROP_RISK_THRESHOLD=0.75
MAX_CHUNKS_PER_CALL=120
